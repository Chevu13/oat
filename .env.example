# Public site URL (canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# /admin is open without a password in the demo. Set to true to require the login below.
ADMIN_REQUIRE_LOGIN=false
# Demo admin login for /admin (replaced by Supabase Auth later)
ADMIN_EMAIL=admin@oatbomb.demo
ADMIN_PASSWORD=change-me
# Random string, at least 32 characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Later, when the client approves (Supabase backend) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Vercel only: shared demo storage (added automatically by Vercel Storage → Upstash Redis)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
